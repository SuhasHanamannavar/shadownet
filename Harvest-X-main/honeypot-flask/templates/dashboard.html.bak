<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<title>MIRAGE — Honeypot Monitor</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#060a0f;--panel:#0d1117;--panel2:#161b22;--border:#30363d;--text:#e6edf3;--muted:#7d8590;--green:#3fb950;--red:#f85149;--orange:#d29922;--blue:#58a6ff}
body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;min-height:100vh}
.topbar{background:var(--panel);border-bottom:1px solid var(--border);padding:14px 28px;display:flex;align-items:center;justify-content:space-between}
.logo{font-family:'JetBrains Mono',monospace;font-weight:700;color:var(--green);font-size:16px;letter-spacing:2px}
.live{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--green)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--green);animation:pulse 1.4s ease infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;padding:24px 28px}
.stat{background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:18px}
.stat-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;margin-bottom:6px}
.stat-val{font-size:32px;font-weight:700;font-family:'JetBrains Mono',monospace}
.stat-val.red{color:var(--red)}
.stat-val.green{color:var(--green)}
.stat-val.blue{color:var(--blue)}
.section{padding:0 28px 24px}
.section-title{font-size:13px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;margin-bottom:14px}
.log-table{background:var(--panel);border:1px solid var(--border);border-radius:8px;overflow:hidden}
table{width:100%;border-collapse:collapse}
th{font-size:10px;color:var(--muted);font-weight:500;text-transform:uppercase;letter-spacing:.5px;padding:10px 14px;background:var(--panel2);border-bottom:1px solid var(--border);text-align:left}
td{padding:9px 14px;font-size:12px;font-family:'JetBrains Mono',monospace;border-bottom:1px solid #0d1117;color:#cbd5e1;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
tr:hover td{background:rgba(255,255,255,.02)}
.tag{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;font-family:'Inter',monospace}
.tag-sql{background:rgba(248,81,73,.15);color:var(--red)}
.tag-xss{background:rgba(210,153,34,.15);color:var(--orange)}
.tag-trav{background:rgba(88,166,255,.15);color:var(--blue)}
.tag-brute{background:rgba(188,140,255,.15);color:#bc8cff}
.tag-cred{background:rgba(248,81,73,.2);color:var(--red)}
.tag-other{background:rgba(125,133,144,.15);color:var(--muted)}
.empty{padding:40px;text-align:center;color:var(--muted);font-size:13px}
</style>
</head>
<body>
<div class="topbar">
  <div>
    <div class="logo">MIRAGE</div>
    <div style="font-size:12px;color:var(--muted);margin-top:2px">Honeypot Monitoring Dashboard</div>
  </div>
  <div class="live"><div class="dot"></div>LIVE — auto-refreshes every 5s</div>
</div>

<div class="stats-row">
  <div class="stat"><div class="stat-label">Total Requests</div><div class="stat-val blue" id="s-total">—</div></div>
  <div class="stat"><div class="stat-label">Attacks Caught</div><div class="stat-val red" id="s-attacks">—</div></div>
  <div class="stat"><div class="stat-label">Normal Traffic</div><div class="stat-val green" id="s-normal">—</div></div>
  <div class="stat"><div class="stat-label">Attack Rate</div><div class="stat-val" id="s-rate" style="color:var(--orange)">—</div></div>
</div>

<div class="section">
  <div class="section-title">Recent Attack Logs</div>
  <div class="log-table">
    <table>
      <thead>
        <tr>
          <th>Timestamp</th>
          <th>IP Address</th>
          <th>Method</th>
          <th>Path</th>
          <th>Attack Type</th>
          <th>Body (preview)</th>
        </tr>
      </thead>
      <tbody id="log-tbody">
        <tr><td colspan="6" class="empty">Loading...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<script>
const TYPE_TAGS = {
  sql_injection:'tag-sql',xss:'tag-xss',path_traversal:'tag-trav',
  brute_force:'tag-brute',credential_harvest:'tag-cred'
};

function tagClass(t){ return TYPE_TAGS[t] || 'tag-other'; }

async function refresh() {
  try {
    const [statsR, logsR] = await Promise.all([
      fetch('/honeypot-dashboard/api/stats'),
      fetch('/honeypot-dashboard/api/logs')
    ]);
    const stats = await statsR.json();
    const logs  = await logsR.json();

    document.getElementById('s-total').textContent   = stats.total   ?? 0;
    document.getElementById('s-attacks').textContent = stats.attacks ?? 0;
    document.getElementById('s-normal').textContent  = stats.normal  ?? 0;
    const rate = stats.total ? Math.round((stats.attacks/stats.total)*100) : 0;
    document.getElementById('s-rate').textContent = rate + '%';

    if (!logs.length) {
      document.getElementById('log-tbody').innerHTML =
        '<tr><td colspan="6" class="empty">No attacks logged yet. Try accessing <code>/login?username=\' OR 1=1</code></td></tr>';
      return;
    }

    document.getElementById('log-tbody').innerHTML = logs.map(l => `
      <tr>
        <td>${l.timestamp}</td>
        <td>${l.ip}</td>
        <td>${l.method}</td>
        <td title="${l.path}">${l.path}</td>
        <td><span class="tag ${tagClass(l.attack_type)}">${l.attack_type}</span></td>
        <td title="${(l.body||'').replace(/"/g,'')}">${(l.body||'').slice(0,40) || '—'}</td>
      </tr>
    `).join('');
  } catch(e) { console.error(e); }
}

refresh();
setInterval(refresh, 5000);
</script>
</body>
</html>
